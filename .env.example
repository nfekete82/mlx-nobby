# Docker Compose: these variables configure the web container.
AGENT_URL=http://host.docker.internal:8010
MLX_WEB_PORT=8090
MAX_UPLOAD_SIZE_MB=250
MLX_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# To expose the web UI through a trusted TLS-terminating reverse proxy such as
# Tailscale Serve, append its hostname, for example:
# MLX_ALLOWED_HOSTS=localhost,127.0.0.1,::1,my-mac.example-tailnet.ts.net

# Legacy MLX_URL, SPEECH_URL and IMAGE_URL are no longer read from the
# environment by the web backend. MLX and speech requests cross AGENT_URL;
# the native MLX port comes from ~/.config/mlx-server/config.

# Native services: set these in the environment of the indicated host process.
# Compose does not pass them to the host; launchd does not load this .env file.
# Agent:
# SPEECH_SERVICE_URL=http://127.0.0.1:8050
# IMAGE_SERVICE_URL=http://127.0.0.1:8030
# MLX_ROUTER_MODEL_PATH=/absolute/path/to/router/model
# Runtime performance tuning:
# MLX_RUNTIME_VIDEO_HEADROOM_GB=14
# MLX_VIDEO_LTX_IDLE_TIMEOUT=300
# MLX_PREFILL_STEP_SIZE=1024
# Native LTX 2.5 MLX video worker:
# LTX_MLX_PERSISTENT=1                # 1 = warm worker process, 0 = one CLI process per job
# MLX_VIDEO_MLX_IDLE_TIMEOUT=300      # seconds to keep the lightweight worker process alive
# LTX_MLX_WORKER_URL=http://127.0.0.1:18061
# LTX_MLX_LOW_RAM=1                   # keep upstream low-memory model lifecycle enabled
# Image performance / Quality+ tuning (native image service):
# MLX_IMAGE_MFLUX_MODE=auto             # auto | performance | balanced | low-ram
# MLX_IMAGE_MFLUX_PERFORMANCE_HEADROOM_GB=16
# MLX_IMAGE_MFLUX_BALANCED_HEADROOM_GB=8
# MLX_IMAGE_MFLUX_PERFORMANCE_CACHE_GB=8
# MLX_IMAGE_MFLUX_BALANCED_CACHE_GB=4
# MLX_IMAGE_MFLUX_LOW_RAM_CACHE_GB=2
# MLX_IMAGE_QUALITY_UPSCALE=auto         # off | auto | required
# MLX_IMAGE_REALESRGAN_BIN=~/.local/bin/realesrgan-ncnn-vulkan
# MLX_IMAGE_REALESRGAN_MODELS=~/.local/share/realesrgan/models
# Embedding adapter / mlx-serve:
# MLX_EMBEDDING_MODEL=mlx-community/Qwen3-Embedding-4B-4bit-DWQ
# MLXSERVE_URL=http://127.0.0.1:11234
# MLX_EMBEDDING_REQUEST_TIMEOUT=180
# MLX_EMBEDDING_CLIENT_TIMEOUT=180
# MLX_EMBEDDING_BATCH_SIZE=64
# MLX_EMBEDDING_QUERY_INSTRUCTION=Given a user query, retrieve relevant source-code and document passages that answer the query
# Speech service:
# MAX_UPLOAD_SIZE_MB=250
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# See docs/DEPENDENCIES.md for service environments and installation.

# Web chat reliability (passed through Docker Compose):
# MLX_CHAT_VISION_FIRST_BYTE_TIMEOUT=60  # seconds before vision assistant output
