new file mode 100644
index 0000000000000000000000000000000000000000..a5720dcd88bc2599716c8e974e70a16c4c05bd29
--- /dev/null
+++ b/tests/test_non_block_loras.py
@@ -0,0 +1,163 @@
+"""Real MLX numerical and fail-closed tests for additive resident LoRA fusion."""
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import mlx.core as mx
+import pytest
+from mlx.utils import tree_flatten
+
+from ltx_core_mlx.loader.block_streaming import BlockLoraSource, BlockStreamer, fuse_non_block_loras
+from ltx_core_mlx.loader.sd_ops import LTXV_LORA_BLOCK_PREFIX, LTXV_LORA_COMFY_RENAMING_MAP
+from ltx_core_mlx.model.transformer.model import LTXModel, LTXModelConfig
+
+TARGETS = [
+    "adaln_single.emb.timestep_embedder.linear1.weight",
+    "audio_adaln_single.emb.timestep_embedder.linear2.weight",
+    "prompt_adaln_single.linear.weight", "audio_adaln_single.linear.weight",
+    "patchify_proj.weight", "audio_patchify_proj.weight",
+    "scale_shift_table", "audio_scale_shift_table",
+]
+BLOCK = "transformer_blocks.0.attn1.to_q.weight"
+
+
+def _tiny_config(num_layers: int = 1) -> LTXModelConfig:
+    """Local synthetic configuration; no cross-test-module dependency."""
+    return LTXModelConfig(
+        num_layers=num_layers,
+        video_dim=32,
+        audio_dim=16,
+        video_num_heads=4,
+        audio_num_heads=4,
+        video_head_dim=8,
+        audio_head_dim=4,
+        av_cross_num_heads=4,
+        av_cross_head_dim=4,
+        video_patch_channels=8,
+        audio_patch_channels=8,
+        ff_mult=2.0,
+        timestep_embedding_dim=32,
+    )
+
+
+def fixture_model():
+    inner = LTXModel(_tiny_config(1))
+    weights = dict(tree_flatten(inner.parameters()))
+    model = SimpleNamespace(inner=inner, _streamer=SimpleNamespace(_weights={
+        "transformer." + k: v for k, v in weights.items()}))
+    return model, weights
+
+
+def source(tmp_path, weights, keys, strength=0.5, filename="synthetic.safetensors"):
+    data, deltas = {}, {}
+    for key in keys:
+        out_dim, in_dim = weights[key].shape
+        name = key.removesuffix(".weight")
+        raw_name = name.replace(".linear1", ".linear_1").replace(".linear2", ".linear_2")
+        a = mx.ones((2, in_dim), dtype=mx.bfloat16)
+        b = mx.full((out_dim, 2), 0.25, dtype=mx.bfloat16)
+        data[f"diffusion_model.{raw_name}.lora_A.weight"] = a
+        data[f"diffusion_model.{raw_name}.lora_B.weight"] = b
+        # Alpha is metadata: the existing fuser uses strength directly.
+        data[f"diffusion_model.{raw_name}.alpha"] = mx.array(7.0)
+        deltas[key] = b.astype(mx.float32) @ a.astype(mx.float32) * strength
+    path = tmp_path / filename
+    mx.save_safetensors(str(path), data)
+    src = BlockLoraSource(path, LTXV_LORA_BLOCK_PREFIX, strength, LTXV_LORA_COMFY_RENAMING_MAP)
+    return src, deltas
+
+
+@pytest.mark.parametrize("target", TARGETS)
+def test_all_target_classes_math_dtype_and_release(tmp_path, target):
+    model, weights = fixture_model()
+    src, deltas = source(tmp_path, weights, [target])
+    expected = (weights[target].astype(mx.float32) + deltas[target]).astype(weights[target].dtype)
+    assert src.validate_pairs(weights) == {target.removesuffix(".weight"): target}
+    fuse_non_block_loras(model, [src])
+    actual = dict(tree_flatten(model.inner.parameters()))[target]
+    assert actual.dtype == weights[target].dtype
+    assert mx.allclose(actual, expected, atol=1e-5).item()
+    assert src._non_block_keys == {}
+    assert not any(k.endswith((".lora_A.weight", ".lora_B.weight")) for k in src._lora_data)
+
+
+def test_mixed_block_and_root_and_multiple_sources(tmp_path):
+    model, weights = fixture_model()
+    src, delta = source(tmp_path, weights, [BLOCK, TARGETS[0]], 0.5)
+    second, delta2 = source(tmp_path, weights, [TARGETS[0]], 0.25, "second.safetensors")
+    original_block = weights[BLOCK]
+    fuse_non_block_loras(model, [src, second])
+    target = TARGETS[0]
+    expected = (weights[target].astype(mx.float32) + delta[target] + delta2[target]).astype(weights[target].dtype)
+    assert mx.allclose(dict(tree_flatten(model.inner.parameters()))[target], expected).item()
+    assert src.has_block(0)
+    fused_block = dict(BlockStreamer._fuse_lora_into_block(
+        [(BLOCK.removeprefix("transformer_blocks.0."), original_block)], 0, [src]))
+    assert mx.allclose(fused_block["attn1.to_q.weight"], original_block + delta[BLOCK]).item()
+
+
+@pytest.mark.parametrize("failure", ["missing_a", "missing_b", "rank", "input", "output", "target", "dtype"])
+def test_validation_rejects_before_mutation(tmp_path, failure):
+    model, weights = fixture_model()
+    src, _ = source(tmp_path, weights, TARGETS[:2])
+    name, slots = next(iter(src._non_block_keys.items()))
+    if failure.startswith("missing_"):
+        del slots[failure[-1]]
+    elif failure == "rank":
+        src._lora_data[slots["b"]] = mx.ones((weights[TARGETS[0]].shape[0], 3))
+    elif failure == "input":
+        src._lora_data[slots["a"]] = mx.ones((2, 3))
+    elif failure == "output":
+        src._lora_data[slots["b"]] = mx.ones((3, 2))
+    elif failure == "target":
+        src._non_block_keys["unknown_target"] = src._non_block_keys.pop(name)
+    else:
+        src._lora_data[slots["a"]] = src._lora_data[slots["a"]].astype(mx.int32)
+    with patch.object(model.inner, "load_weights") as load:
+        with pytest.raises(ValueError):
+            fuse_non_block_loras(model, [src])
+        load.assert_not_called()
+    assert dict(tree_flatten(model.inner.parameters()))[TARGETS[0]] is weights[TARGETS[0]]
+
+
+def test_no_lora_and_block_only_do_not_mutate_resident_weights(tmp_path):
+    model, weights = fixture_model()
+    src, _ = source(tmp_path, weights, [BLOCK])
+    with patch.object(model.inner, "load_weights") as load, patch("mlx.core.eval") as evaluate:
+        fuse_non_block_loras(model, [])
+        fuse_non_block_loras(model, [src])
+        load.assert_not_called()
+        evaluate.assert_not_called()
+    assert src.validate_pairs(weights) == {BLOCK.removesuffix(".weight"): BLOCK}
+    assert src.has_block(0)
+
+
+def test_targetwise_materialisation_precedes_next_target(tmp_path):
+    model, weights = fixture_model()
+    src, _ = source(tmp_path, weights, TARGETS)
+    events = []
+    original_eval, original_load = mx.eval, model.inner.load_weights
+    def evaluate(arrays):
+        events.append("eval")
+        return original_eval(arrays)
+    def load(items, **kwargs):
+        events.append("load")
+        return original_load(items, **kwargs)
+    with patch("mlx.core.eval", side_effect=evaluate), patch.object(model.inner, "load_weights", side_effect=load):
+        fuse_non_block_loras(model, [src])
+    assert events == ["eval", "load"] * len(TARGETS)
+
+
+def test_fusion_failure_does_not_publish_streaming_model(tmp_path):
+    from pathlib import Path
+    from ltx_pipelines_mlx._base import BasePipeline
+    model, weights = fixture_model()
+    src, _ = source(tmp_path, weights, [TARGETS[0]])
+    model._lora_sources = []
+    stub = SimpleNamespace(verbose=False, low_ram_streaming=True, _pending_loras=[("fake", 1.0)])
+    with patch("ltx_pipelines_mlx.utils._orchestration.load_transformer", return_value=model), \
+         patch("ltx_pipelines_mlx.utils._orchestration.resolve_lora_path", return_value="fake"), \
+         patch("ltx_core_mlx.loader.block_streaming.BlockLoraSource", return_value=src), \
+         patch("mlx.core.eval", side_effect=RuntimeError("synthetic failure")):
+        with pytest.raises(RuntimeError, match="synthetic failure"):
+            BasePipeline._load_transformer_with_optional_streaming(stub, Path("fake"))
+    assert model._lora_sources == []
