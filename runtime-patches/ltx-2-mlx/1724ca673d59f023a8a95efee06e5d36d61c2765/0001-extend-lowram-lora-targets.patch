+def fuse_non_block_loras(model, sources: list[BlockLoraSource]) -> None:
+    """Fuse resident parameters of a fresh streaming model one target at a time.
+
+    All sources are validated before mutation. The caller publishes the model
+    only on success. Blocks remain lazy and use the original bind-time fuser.
+    """
