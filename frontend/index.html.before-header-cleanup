                        </button>
                    </div>
                </div>

            </div>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">

            <div class="text-sm text-slate-400 mb-4">Server</div>
            <div id="serverState" class="text-2xl font-bold">–</div>

            <div class="grid grid-cols-2 gap-3 mt-6">

