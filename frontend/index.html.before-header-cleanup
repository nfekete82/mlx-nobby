                >
            </div>

            <div>
                <label class="block text-sm text-slate-400 mb-2">
                    Hugging Face Repository
                </label>

                <input
                    id="addModelRepo"
                    type="text"
                    placeholder="mlx-community/..."
                    autocomplete="off"
                    class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-3 outline-none focus:border-blue-500 font-mono text-sm"
                >
            </div>

            <button
                id="addModelButton"
                type="submit"
                class="bg-blue-700 hover:bg-blue-600 disabled:opacity-40 rounded-xl px-5 py-3 font-semibold whitespace-nowrap"
            >
                + Hinzufügen & herunterladen
