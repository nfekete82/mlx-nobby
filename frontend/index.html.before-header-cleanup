    >
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8">

            <h2 class="text-xl font-semibold">
                System
            </h2>

            <p class="text-slate-400 mt-2">
                Systemmonitor wird im nächsten Schritt eingebaut.
            </p>

        </div>
    </section>


    <section
        id="logsViewPlaceholder"
        data-app-view="logs"
        class="hidden"
    >
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8">

            <h2 class="text-xl font-semibold">
                Logs
