        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <div class="lg:col-span-2 bg-slate-900 border border-slate-800 rounded-2xl p-6">

            <div class="mb-6">
                <div class="text-sm text-slate-400 mb-2">Aktuelles Modell</div>
                <div id="model" class="text-xl font-semibold break-all">–</div>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">

                <div class="bg-slate-950 rounded-xl p-4">
                    <div class="text-xs uppercase text-slate-500">PID</div>
                    <div id="pid" class="text-xl font-semibold mt-1">–</div>
                </div>

                <div class="bg-slate-950 rounded-xl p-4">
