        </form>

        <div id="addModelStatus"
             class="text-sm text-slate-400 mt-4 min-h-[22px]">
        </div>

    </div>


    <div class="mt-6 bg-slate-900 border border-slate-800 rounded-2xl p-6">

        <div class="flex items-center justify-between mb-5">
            <div>
                <h2 class="text-lg font-semibold">Modelle</h2>
                <p class="text-sm text-slate-400">
                    Konfigurierte MLX-Aliase
                </p>
            </div>
        </div>

        <div
            id="models"
            class="grid grid-cols-1 lg:grid-cols-2 gap-4"
        >
            Modelle werden geladen…
        </div>

    </div>
    <div class="mt-6 bg-slate-900 border border-slate-800 rounded-2xl p-6">

        <div class="flex items-center justify-between gap-4 mb-5">
            <div>
                <h2 class="text-lg font-semibold">Lokaler Cache</h2>
                <p class="text-sm text-slate-400">
                    Hugging-Face-Modelle auf diesem Mac
                </p>
            </div>

            <div id="cacheSummary"
                 class="text-sm text-slate-400">
                Wird geladen…
            </div>
        </div>

        <div id="cacheModels"
             class="space-y-3">
            Cache wird geladen…
        </div>

    </div>

    <div class="mt-6 bg-slate-900 border border-slate-800 rounded-2xl p-6">

        <div class="flex items-center justify-between mb-5">
            <div>
                <h2 class="text-lg font-semibold">Downloads & Jobs</h2>
                <p class="text-sm text-slate-400">
                    Laufende und abgeschlossene Hintergrundaufgaben
                </p>
            </div>

            <div id="jobsSummary"
                 class="text-sm text-slate-400">
                Wird geladen…
            </div>
        </div>

        <div id="jobsContainer"
             class="space-y-4">
            Jobs werden geladen…
        </div>

    </div>

</div>

<div
