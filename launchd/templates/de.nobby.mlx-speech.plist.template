<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>de.nobby.mlx-speech</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_DIR__/speech-venv/bin/python</string>
        <string>-m</string>
        <string>uvicorn</string>
        <string>speech.app:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8050</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__CONFIG_DIR__/speech.log</string>

    <key>StandardErrorPath</key>
    <string>__CONFIG_DIR__/speech-error.log</string>
</dict>
</plist>
