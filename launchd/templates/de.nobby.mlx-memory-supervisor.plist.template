<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>de.nobby.mlx-memory-supervisor</string>
  <key>ProgramArguments</key><array>
    <string>__PROJECT_DIR__/runtime-venv/bin/python</string>
    <string>-m</string><string>agent.memory_model_supervisor</string>
  </array>
  <key>WorkingDirectory</key><string>__PROJECT_DIR__</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>20</integer>
  <key>StandardOutPath</key><string>__CONFIG_DIR__/memory-supervisor.log</string>
  <key>StandardErrorPath</key><string>__CONFIG_DIR__/memory-supervisor-error.log</string>
</dict></plist>
