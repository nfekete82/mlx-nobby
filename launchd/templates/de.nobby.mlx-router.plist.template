<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>de.nobby.mlx-router</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/scripts/mlx-router-start</string>
        <string>__RUNTIME_PYTHON__</string>
        <string>__ROUTER_MODEL__</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__CONFIG_DIR__/router.log</string>

    <key>StandardErrorPath</key>
    <string>__CONFIG_DIR__/router-error.log</string>
</dict>
</plist>
