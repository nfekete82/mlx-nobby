#!/bin/bash

set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PATCH_ROOT="$PROJECT_ROOT/runtime-patches/ltx-2-mlx"
PATCH_HELPER="$PROJECT_ROOT/scripts/apply-runtime-patches.py"

UPSTREAM_REPO="https://github.com/dgrauet/ltx-2-mlx.git"
UPSTREAM_COMMIT="1724ca673d59f023a8a95efee06e5d36d61c2765"
UPSTREAM_VERSION="0.15.12"
RUNTIME_ROOT="${LTX_MLX_RUNTIME_ROOT:-$HOME/.local/share/mlx-nobby/ltx-2-mlx}"
MODEL_ROOT="${LTX_MLX_MODEL_ROOT:-$HOME/.local/share/mlx-nobby/models}"
MODEL_DIR="$MODEL_ROOT/ltx-2.5-mlx-q4"
MODEL_REPO="dgrauet/ltx-2.5-mlx-q4"
READY_MARKER="$MODEL_DIR/.mlx-nobby-ready"

fail() {
    echo "ERROR: $*" >&2
    exit 1
}

if [ "$(uname -s)" != "Darwin" ] || [ "$(uname -m)" != "arm64" ]; then
    fail "LTX-MLX wird von diesem Setup nur auf Apple Silicon/macOS installiert."
fi

command -v git >/dev/null 2>&1 || fail "git fehlt."
command -v uv >/dev/null 2>&1 || fail "uv fehlt. Installiere zuerst uv."
command -v python3 >/dev/null 2>&1 || fail "python3 fehlt."

mkdir -p "$(dirname "$RUNTIME_ROOT")" "$MODEL_ROOT"

echo "============================================================"
echo "MLX NOBBY — LTX 2.5 MLX Q4 SETUP"
echo "============================================================"
echo "Runtime: $RUNTIME_ROOT"
echo "Upstream: ltx-2-mlx $UPSTREAM_VERSION"
echo "Pin:      $UPSTREAM_COMMIT"
echo "Model:    $MODEL_REPO"
echo

echo "[1/3] Upstream-Runtime installieren/aktualisieren"
if [ ! -d "$RUNTIME_ROOT/.git" ]; then
    [ ! -e "$RUNTIME_ROOT" ] || fail "Runtime-Verzeichnis existiert ohne Git-Checkout; keine Dateien werden entfernt."
    git clone "$UPSTREAM_REPO" "$RUNTIME_ROOT"
else
    if [ "$(git -C "$RUNTIME_ROOT" rev-parse HEAD)" = "$UPSTREAM_COMMIT" ]; then
        python3 "$PATCH_HELPER" "$RUNTIME_ROOT" "$UPSTREAM_COMMIT" "$PATCH_ROOT" --check-state
    elif [ -n "$(git -C "$RUNTIME_ROOT" status --porcelain --untracked-files=all)" ]; then
        fail "Unerwartete lokale Runtime-Änderungen; Checkout wird nicht verändert."
    fi
    git -C "$RUNTIME_ROOT" remote set-url origin "$UPSTREAM_REPO"
fi

git -C "$RUNTIME_ROOT" fetch --quiet origin "$UPSTREAM_COMMIT"
git -C "$RUNTIME_ROOT" checkout --quiet --detach "$UPSTREAM_COMMIT"
python3 "$PATCH_HELPER" "$RUNTIME_ROOT" "$UPSTREAM_COMMIT" "$PATCH_ROOT"
(
    cd "$RUNTIME_ROOT"
    uv sync --frozen
)

CLI="$RUNTIME_ROOT/.venv/bin/ltx-2-mlx"
[ -x "$CLI" ] || fail "CLI wurde nicht erzeugt: $CLI"
"$CLI" --help >/dev/null

echo "[2/3] LTX 2.5 MLX Q4 herunterladen"
echo "Hinweis: Nobby akzeptiert keine Modell-Lizenz automatisch."
echo "Falls Hugging Face den Download sperrt, akzeptiere dort zuerst die"
echo "Bedingungen für $MODEL_REPO und melde dich lokal mit 'hf auth login' an."
rm -f "$READY_MARKER"

if ! (
    cd "$RUNTIME_ROOT"
    uv run --with huggingface_hub python - "$MODEL_REPO" "$MODEL_DIR" <<'PY'
import sys
from huggingface_hub import snapshot_download

repo_id, destination = sys.argv[1:]
snapshot_download(repo_id=repo_id, local_dir=destination)
PY
); then
    fail "Q4-Download fehlgeschlagen. Prüfe Hugging-Face-Zugriff/Lizenz und führe das Setup erneut aus."
fi

[ -f "$MODEL_DIR/embedded_config.json" ] || fail "Q4-Modell ist unvollständig: embedded_config.json fehlt."
[ -f "$MODEL_DIR/text_encoder.safetensors" ] || fail "Q4-Modell ist unvollständig: pack-lokaler Gemma-4-Encoder fehlt."
[ -f "$MODEL_DIR/text_encoder_config.json" ] || fail "Q4-Modell ist unvollständig: text_encoder_config.json fehlt."

echo "[3/3] Installation validieren"
touch "$READY_MARKER"

MODEL_SIZE="$(du -sh "$MODEL_DIR" 2>/dev/null | awk '{print $1}')"

echo
echo "LTX 2.5 MLX Q4 ist bereit."
echo "  Runtime: $CLI"
echo "  Q4-Pack: $MODEL_DIR (${MODEL_SIZE:-?})"
echo "  Encoder: Gemma 4 aus dem LTX-2.5-Pack (kein separater Download)"
echo
echo "MLX Q4 ist Nobbys Standard-Video-Backend; der PyTorch/MPS-Pfad bleibt als Fallback verfügbar."
echo "Nach einem Nobby-Neustart kann der Worker direkt über die normale Video-Generierung verwendet werden."
