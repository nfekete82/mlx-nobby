#!/bin/bash

CONFIG="$HOME/.config/mlx-server/config"
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON="${MLX_RUNTIME_PYTHON:-${PROJECT_DIR}/runtime-venv/bin/python}"

if [ ! -x "$PYTHON" ]; then
    echo "MLX Runtime Python fehlt oder ist nicht ausführbar: $PYTHON" >&2
    echo "Installiere zuerst die MLX nobby Runtime." >&2
    exit 1
fi

if [ ! -f "$CONFIG" ]; then
    echo "Konfiguration fehlt: $CONFIG"
    exit 1
fi

source "$CONFIG"

detect_backend() {
    local model="$1"

    # Detect local models automatically through config.json
    if [ -d "$model" ] && [ -f "$model/config.json" ]; then

        "$PYTHON" - "$model/config.json" <<'PY'
import json
import sys

path = sys.argv[1]

try:
    with open(path, "r", encoding="utf-8") as f:
        cfg = json.load(f)
except Exception:
    print("lm")
    raise SystemExit

architectures = cfg.get("architectures") or []
model_type = str(cfg.get("model_type", "")).lower()
vision_config = cfg.get("vision_config")

text = " ".join(map(str, architectures)).lower()

is_vlm = (
    vision_config is not None
    or "vision" in text
    or "conditionalgeneration" in text
    or "_vl" in text
    or "-vl" in text
    or "_vl" in model_type
    or "-vl" in model_type
)

print("vlm" if is_vlm else "lm")
PY
        return
    fi

    # Existing Hugging Face models remain language models.
    echo "lm"
}

adaptive_prefill_step_size() {
    if [ -n "${MLX_PREFILL_STEP_SIZE:-}" ]; then
        case "$MLX_PREFILL_STEP_SIZE" in
            ''|*[!0-9]*)
                echo "Ungültiges MLX_PREFILL_STEP_SIZE: $MLX_PREFILL_STEP_SIZE" >&2
                return 1
                ;;
            *)
                if [ "$MLX_PREFILL_STEP_SIZE" -lt 128 ] || [ "$MLX_PREFILL_STEP_SIZE" -gt 4096 ]; then
                    echo "MLX_PREFILL_STEP_SIZE muss zwischen 128 und 4096 liegen" >&2
                    return 1
                fi
                echo "$MLX_PREFILL_STEP_SIZE"
                return
                ;;
        esac
    fi

    # Larger unified-memory Macs can prefill longer context chunks efficiently.
    # Keep smaller machines on the conservative upstream-sized default.
    local memory_bytes
    memory_bytes="$(sysctl -n hw.memsize 2>/dev/null || true)"
    if [[ "$memory_bytes" =~ ^[0-9]+$ ]] && [ "$memory_bytes" -ge 34359738368 ]; then
        echo "1024"
    else
        echo "512"
    fi
}

model_reference_available() {
    local reference="$1"
    local expanded="$reference"

    if [[ "$expanded" == "~/"* ]]; then
        expanded="$HOME/${expanded#\~/}"
    fi

    if [ -d "$expanded" ]; then
        return 0
    fi

    # Hugging Face snapshot entries are commonly symlinks into the blob store,
    # so follow links when checking for a fully materialized cached config.
    if [[ "$reference" == */* && "$reference" != /* ]]; then
        local hub_cache
        local cache_name
        hub_cache="${HF_HUB_CACHE:-${HF_HOME:-$HOME/.cache/huggingface}/hub}"
        cache_name="models--${reference//\//--}"
        if [ -d "$hub_cache/$cache_name/snapshots" ] && \
           find -L "$hub_cache/$cache_name/snapshots" -mindepth 2 -maxdepth 2 \
               -name config.json -type f -print -quit 2>/dev/null | grep -q .; then
            return 0
        fi
    fi

    return 1
}

BACKEND="$(detect_backend "$MODEL")"
PREFILL_STEP_SIZE="$(adaptive_prefill_step_size)" || exit 1

SPECULATIVE_ENABLED=false
SPECULATIVE_STATUS="disabled"
SPECULATIVE_TARGET_VALUE="${SPECULATIVE_TARGET:-}"
SPECULATIVE_DRAFT_VALUE="${SPECULATIVE_DRAFT_MODEL:-}"
SPECULATIVE_KIND_VALUE="${SPECULATIVE_DRAFT_KIND:-dflash}"
SPECULATIVE_BLOCK_VALUE="${SPECULATIVE_DRAFT_BLOCK_SIZE:-}"

if [ -n "$SPECULATIVE_TARGET_VALUE" ] && \
   [ -n "$SPECULATIVE_DRAFT_VALUE" ] && \
   [ "$MODEL" = "$SPECULATIVE_TARGET_VALUE" ]; then
    if [ "$BACKEND" != "vlm" ]; then
        SPECULATIVE_STATUS="disabled (configured target is not using mlx-vlm)"
    elif [[ ! "$SPECULATIVE_KIND_VALUE" =~ ^(dflash|eagle3|mtp)$ ]]; then
        echo "Ungültiges SPECULATIVE_DRAFT_KIND: $SPECULATIVE_KIND_VALUE" >&2
        exit 1
    elif [ -n "$SPECULATIVE_BLOCK_VALUE" ] && \
         { [[ ! "$SPECULATIVE_BLOCK_VALUE" =~ ^[0-9]+$ ]] || \
           [ "$SPECULATIVE_BLOCK_VALUE" -lt 2 ] || \
           [ "$SPECULATIVE_BLOCK_VALUE" -gt 64 ]; }; then
        echo "SPECULATIVE_DRAFT_BLOCK_SIZE muss leer oder zwischen 2 und 64 liegen" >&2
        exit 1
    elif model_reference_available "$SPECULATIVE_DRAFT_VALUE"; then
        SPECULATIVE_ENABLED=true
        if [ -n "$SPECULATIVE_BLOCK_VALUE" ]; then
            SPECULATIVE_STATUS="enabled ($SPECULATIVE_KIND_VALUE, block $SPECULATIVE_BLOCK_VALUE)"
        else
            SPECULATIVE_STATUS="enabled ($SPECULATIVE_KIND_VALUE, model default block)"
        fi
    else
        SPECULATIVE_STATUS="disabled (draft model is not cached locally)"
    fi
elif [ -n "$SPECULATIVE_TARGET_VALUE" ] && [ "$MODEL" != "$SPECULATIVE_TARGET_VALUE" ]; then
    SPECULATIVE_STATUS="disabled (target mismatch)"
fi

"$PYTHON" "$PROJECT_DIR/scripts/runtime-model-guard.py" \
    --workload chat \
    --wait

echo
echo "============================================================"
echo "MLX Server Start"
echo "============================================================"
echo "Modell:      $MODEL"
echo "Backend:     $BACKEND"
echo "Port:        $PORT"
echo "Thinking:    $THINKING"
echo "Prefill:     $PREFILL_STEP_SIZE"
echo "Speculative: $SPECULATIVE_STATUS"
echo "============================================================"
echo

if [ "$BACKEND" = "vlm" ]; then

    ARGS=(
        -m mlx_vlm server
        --model "$MODEL"
        --host 127.0.0.1
        --port "$PORT"
        --prefill-step-size "$PREFILL_STEP_SIZE"
        --max-num-seqs 2
    )

    if [ "$SPECULATIVE_ENABLED" = "true" ]; then
        ARGS+=(
            --draft-model "$SPECULATIVE_DRAFT_VALUE"
            --draft-kind "$SPECULATIVE_KIND_VALUE"
        )
        if [ -n "$SPECULATIVE_BLOCK_VALUE" ]; then
            ARGS+=(--draft-block-size "$SPECULATIVE_BLOCK_VALUE")
        fi
    fi

    if [ "$THINKING" = "true" ]; then
        ARGS+=(--enable-thinking)
    fi

    echo "Starte mlx_vlm..."
    exec "$PYTHON" "${ARGS[@]}"

else

    ARGS=(
        -m mlx_lm.server
        --model "$MODEL"
        --host 127.0.0.1
        --port "$PORT"
        --prefill-step-size "$PREFILL_STEP_SIZE"
    )

    echo "Starte mlx_lm..."
    exec "$PYTHON" "${ARGS[@]}"
fi
