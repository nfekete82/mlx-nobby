#!/bin/bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON="${1:-}"
MODEL="${2:-}"

if [ -z "$PYTHON" ] || [ ! -x "$PYTHON" ]; then
    echo "Router Runtime Python fehlt oder ist nicht ausführbar: $PYTHON" >&2
    exit 1
fi

if [ -z "$MODEL" ]; then
    echo "Router-Modell fehlt." >&2
    exit 1
fi

"$PYTHON" "$PROJECT_DIR/scripts/runtime-model-guard.py" \
    --workload router \
    --wait

ARGS=(
    -m mlx_vlm server
    --model "$MODEL"
    --host 127.0.0.1
    --port 8040
    --max-num-seqs 2
)

# Only as part of a coordinated, system-wide admission deployment.
case "${LTX_LAB_ADMISSION:-0}" in
    0) exec "$PYTHON" "${ARGS[@]}" ;;
    1) exec "$PYTHON" -m ltx_lab.guarded_serve --role router -- "${ARGS[@]}" ;;
    *) echo "LTX_LAB_ADMISSION muss 0 oder 1 sein." >&2; exit 1 ;;
esac
