#!/bin/bash
set -euo pipefail

REPOSITORY="https://github.com/barnent1/musetalk-mac.git"
PINNED_REVISION="${MUSETALK_REVISION:-7fd019315127d7f31e2e7f9853547ddceabbeb6e}"
OFFICIAL_SOURCE_REVISION="${MUSETALK_SOURCE_REVISION:-db204311a54a332843fea9b336e7649ad2322596}"
OFFICIAL_MODELS_BASE="https://raw.githubusercontent.com/TMElyralab/MuseTalk/${OFFICIAL_SOURCE_REVISION}/musetalk/models"
INSTALL_DIR="${MUSETALK_DIR:-$HOME/musetalk-mac}"
PORT="${MUSETALK_PORT:-8070}"
LABEL="de.nobby.musetalk"
PLIST="$HOME/Library/LaunchAgents/${LABEL}.plist"
LOG_DIR="$HOME/.config/mlx-web"
PID_FILE="$LOG_DIR/musetalk.pid"
DOMAIN="gui/$(id -u)"

if [ "$(uname -m)" != "arm64" ]; then
    echo "Error: MuseTalk-Mac requires Apple Silicon (arm64)." >&2
    exit 1
fi

for command in git ffmpeg curl; do
    if ! command -v "$command" >/dev/null 2>&1; then
        echo "Error: required command not found: $command" >&2
        exit 1
    fi
done

PYTHON_BIN="${MUSETALK_PYTHON:-$(command -v python3.11 || true)}"
if [ -z "$PYTHON_BIN" ] || [ ! -x "$PYTHON_BIN" ]; then
    cat >&2 <<'EOF'
Error: Python 3.11 was not found.
Install it first, for example:
  brew install python@3.11
Then run this setup again.
EOF
    exit 1
fi

mkdir -p "$LOG_DIR" "$HOME/Library/LaunchAgents"

if [ ! -d "$INSTALL_DIR/.git" ]; then
    echo "Cloning MuseTalk-Mac..."
    git clone "$REPOSITORY" "$INSTALL_DIR"
else
    current_remote="$(git -C "$INSTALL_DIR" remote get-url origin 2>/dev/null || true)"
    if [ "$current_remote" != "$REPOSITORY" ] && [ "$current_remote" != "${REPOSITORY%.git}" ]; then
        echo "Error: $INSTALL_DIR is a git repository with a different origin: $current_remote" >&2
        exit 1
    fi
fi

echo "Selecting tested MuseTalk-Mac revision $PINNED_REVISION..."
git -C "$INSTALL_DIR" fetch --quiet origin
git -C "$INSTALL_DIR" checkout --detach "$PINNED_REVISION"

# The pinned musetalk-mac commit references musetalk.models from its vendored
# upstream tree, but that repository revision accidentally omits the models/
# Python source directory. Restore only the v1.5 source modules from the
# official MuseTalk repository at a fixed revision. Model weights remain local.
MODELS_SOURCE_DIR="$INSTALL_DIR/upstream/musetalk/models"
if [ ! -f "$MODELS_SOURCE_DIR/vae.py" ] || [ ! -f "$MODELS_SOURCE_DIR/unet.py" ]; then
    echo "Restoring missing MuseTalk v1.5 model source modules..."
    mkdir -p "$MODELS_SOURCE_DIR"
    for source_file in vae.py unet.py; do
        tmp_file="$MODELS_SOURCE_DIR/${source_file}.tmp"
        curl -fsSL --retry 3 --retry-delay 1 \
            "$OFFICIAL_MODELS_BASE/$source_file" \
            -o "$tmp_file"
        mv "$tmp_file" "$MODELS_SOURCE_DIR/$source_file"
    done

    "$PYTHON_BIN" - "$MODELS_SOURCE_DIR/unet.py" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
old = "weights = torch.load(model_path) if torch.cuda.is_available() else torch.load(model_path, map_location=self.device)"
new = 'weights = torch.load(model_path, map_location="cpu", weights_only=False)'
if old in text:
    text = text.replace(old, new, 1)
elif new not in text:
    raise SystemExit("Error: unexpected MuseTalk UNet source; refusing to patch it")
path.write_text(text, encoding="utf-8")
PY
fi

if [ ! -x "$INSTALL_DIR/.venv/bin/python" ]; then
    "$PYTHON_BIN" -m venv "$INSTALL_DIR/.venv"
fi

echo "Installing MuseTalk-Mac dependencies..."
"$INSTALL_DIR/.venv/bin/python" -m pip install --upgrade pip setuptools wheel
"$INSTALL_DIR/.venv/bin/python" -m pip install -r "$INSTALL_DIR/requirements-mac.txt"

if [ ! -f "$INSTALL_DIR/upstream/models/musetalkV15/unet.pth" ] || \
   [ ! -d "$INSTALL_DIR/upstream/models/whisper" ]; then
    echo "Downloading MuseTalk model weights..."
    (
        cd "$INSTALL_DIR"
        PATH="$INSTALL_DIR/.venv/bin:$PATH" ./download_weights_mac.sh
    )
fi

DEMO_MEDIA_DIR="$INSTALL_DIR/upstream/data/demo_five"
if [ ! -d "$DEMO_MEDIA_DIR" ]; then
    echo "Creating optional MuseTalk demo media directory..."
    mkdir -p "$DEMO_MEDIA_DIR"
fi

echo "Validating MuseTalk source imports..."
(
    cd "$INSTALL_DIR/upstream"
    PYTHONPATH="$INSTALL_DIR/upstream" "$INSTALL_DIR/.venv/bin/python" - <<'PY'
from musetalk.models.unet import PositionalEncoding, UNet
from musetalk.models.vae import VAE
from musetalk.utils.utils import load_all_model

assert PositionalEncoding is not None
assert UNet is not None
assert VAE is not None
assert load_all_model is not None
PY
)

echo "Validating MuseTalk server import..."
(
    cd "$INSTALL_DIR"
    PYTHONPATH="$INSTALL_DIR:$INSTALL_DIR/upstream" "$INSTALL_DIR/.venv/bin/python" - <<'PY'
import server

assert server.app is not None
PY
)

cat > "${PLIST}.tmp" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd &quot;${INSTALL_DIR}&quot; &amp;&amp; exec &quot;${INSTALL_DIR}/.venv/bin/uvicorn&quot; server:app --host 127.0.0.1 --port ${PORT}</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTORCH_ENABLE_MPS_FALLBACK</key>
        <string>1</string>
        <key>MUSETALK_FP16_VAE</key>
        <string>1</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>${LOG_DIR}/musetalk.log</string>
    <key>StandardErrorPath</key>
    <string>${LOG_DIR}/musetalk-error.log</string>
</dict>
</plist>
EOF

plutil -lint "${PLIST}.tmp" >/dev/null
mv "${PLIST}.tmp" "$PLIST"
chmod 600 "$PLIST"

unload_launch_agent() {
    launchctl bootout "$DOMAIN/$LABEL" >/dev/null 2>&1 || true
    launchctl bootout "$DOMAIN" "$PLIST" >/dev/null 2>&1 || true

    for _wait in $(seq 1 20); do
        if ! launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; then
            return 0
        fi
        sleep 0.25
    done
    return 0
}

start_fallback_process() {
    if [ -f "$PID_FILE" ]; then
        old_pid="$(cat "$PID_FILE" 2>/dev/null || true)"
        if [ -n "$old_pid" ] && kill -0 "$old_pid" >/dev/null 2>&1; then
            kill "$old_pid" >/dev/null 2>&1 || true
            sleep 1
        fi
        rm -f "$PID_FILE"
    fi

    echo "Starting MuseTalk directly because launchctl bootstrap is unavailable..."
    (
        cd "$INSTALL_DIR"
        nohup env \
            PYTORCH_ENABLE_MPS_FALLBACK=1 \
            MUSETALK_FP16_VAE=1 \
            PYTHONUNBUFFERED=1 \
            "$INSTALL_DIR/.venv/bin/uvicorn" server:app \
            --host 127.0.0.1 --port "$PORT" \
            >>"$LOG_DIR/musetalk.log" \
            2>>"$LOG_DIR/musetalk-error.log" < /dev/null &
        echo $! > "$PID_FILE"
    )
}

unload_launch_agent
bootstrap_ok=0
for _bootstrap_attempt in 1 2 3; do
    if launchctl bootstrap "$DOMAIN" "$PLIST"; then
        bootstrap_ok=1
        break
    fi
    echo "launchctl bootstrap attempt ${_bootstrap_attempt}/3 failed; retrying..." >&2
    unload_launch_agent
    sleep "$_bootstrap_attempt"
done

if [ "$bootstrap_ok" -eq 1 ]; then
    rm -f "$PID_FILE"
    launchctl kickstart -k "$DOMAIN/$LABEL"
else
    echo "Warning: launchctl could not register MuseTalk after 3 attempts." >&2
    echo "Falling back to a detached local process for this session." >&2
    start_fallback_process
fi

echo "Starting MuseTalk-Mac on http://127.0.0.1:${PORT} ..."
for _attempt in $(seq 1 300); do
    if curl -fsS --connect-timeout 1 --max-time 2 \
        "http://127.0.0.1:${PORT}/health" >/dev/null 2>&1; then
        echo
        echo "MuseTalk-Mac is ready."
        if [ "$bootstrap_ok" -eq 1 ]; then
            echo "LaunchAgent installed for automatic startup."
        else
            echo "MuseTalk is running in fallback background mode; automatic login startup is not active yet."
        fi
        echo "Talking Photo can now be used from MLX Nobby."
        exit 0
    fi
    sleep 1
done

echo "Error: MuseTalk-Mac did not become ready." >&2
echo "Inspect: $LOG_DIR/musetalk-error.log" >&2
exit 1
